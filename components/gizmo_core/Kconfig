menu "Gizmo core"

    config GIZMO_HMI_COUNTS_PER_STEP
        int "Module HMI encoder counts per detent"
        range 1 8
        default 1
        help
            Raw encoder counts the Module HMI reports for one mechanical click.
            If one click moves focus by more than one item, raise this.
            Enable debug logging for tag "hmi" to see raw deltas.

    config GIZMO_HMI_REVERSE
        bool "Reverse Module HMI encoder direction"
        default n

    config GIZMO_NTP_SERVER
        string "NTP server"
        default "pool.ntp.org"
        help
            Queried once Wi-Fi is connected; lwIP re-syncs periodically.

    config GIZMO_DEFAULT_TIMEZONE
        string "Default timezone (IANA name)"
        default "Etc/UTC"
        help
            Used until a timezone is picked in Settings -> Network, e.g.
            "Asia/Singapore", "Europe/Berlin", "America/New_York".
            Must be one of the zones in components/gizmo_core/timezones.c;
            unknown names fall back to Etc/UTC.

endmenu
